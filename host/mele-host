#!/usr/bin/env bash
# Mele Host 管理命令（10-04），装在 /usr/local/bin。
# 整个包进 main、最后才调用（10-16）：update 会把这个文件自己换掉，bash 是边跑边读的，不包起来换完会接着读新文件的半截
set -euo pipefail

main() {
cd "${MELE_HOST_DIR:-/opt/mele-host}"
set -a; . ./.env; set +a
RAW=${MELE_RAW:-https://raw.githubusercontent.com/aporia-and-poros/mele-lite/main/host}

case "${1:-help}" in
  pair)
    out=$(docker compose exec -T mele python -m api.host pair)
    echo "$out"
    link=$(printf '%s\n' "$out" | sed -n 's/^配对链接（App 扫二维码用）：//p')
    if [ -n "$link" ] && command -v qrencode >/dev/null; then qrencode -t ansiutf8 "$link"; fi
    ;;
  status) docker compose ps; docker compose exec -T mele python -m api.host status ;;
  update) refresh_config
          docker compose pull || { echo "拉新镜像失败：看看网络，过会儿再 mele-host update"; exit 1; }
          docker compose up -d && docker image prune -f >/dev/null
          echo "更新好了。现在的版本："; sleep 3; docker compose exec -T mele printenv NEWAPP_BUILD || echo "（起来以后 mele-host status 能看）" ;;
  memory) shift; memory "$@" ;;
  tunnel) shift; tunnel "$@" ;;
  backup) backup ;;
  restore) shift; restore "$@" ;;
  logs)   docker compose logs -f --tail 200 "${2:-mele}" ;;
  stop)   docker compose stop ;;
  start)  docker compose up -d ;;
  key)    echo "$MASTER_KEY" ;;
  *) echo "用法：mele-host pair | status | update | logs | stop | start | key | backup | restore 文件 | tunnel on|off|status | memory off|status" ;;
esac
}

# update 顺带把配置换成最新的（10-16：以前只拉镜像，docker-compose.yml 改了老用户收不到）。
# 自己改过的旧文件留一份 .bak
refresh_config() {
  local tmp f
  tmp=$(mktemp -d)
  for f in docker-compose.yml Caddyfile mele-host; do
    curl -fsSL "$RAW/$f" -o "$tmp/$f" || { echo "下载 $f 失败，配置先不换"; rm -rf "$tmp"; return 0; }
  done
  for f in docker-compose.yml Caddyfile; do
    if [ ! -f "$f" ]; then cp "$tmp/$f" "$f"; echo "补上了 $f"
    elif ! cmp -s "$tmp/$f" "$f"; then cp "$f" "$f.bak"; cp "$tmp/$f" "$f"; echo "换了新的 $f（旧的留在 $f.bak）"; fi
  done
  if ! cmp -s "$tmp/mele-host" /usr/local/bin/mele-host 2>/dev/null; then
    install -m 755 "$tmp/mele-host" /usr/local/bin/mele-host 2>/dev/null && echo "mele-host 命令也更新了"
  fi
  rm -rf "$tmp"
}

setenv() {   # 在 .env 里设一行（有就改、没有就加）
  if grep -q "^$1=" .env; then sed -i.tmp "s|^$1=.*|$1=$2|" .env && rm -f .env.tmp; else echo "$1=$2" >> .env; fi
  export "$1=$2"
}

# 隧道模式（10-17 内测）：Host 装在家里 / 学校、没有公网 IP 的电脑上，HTTPS 交给 Tailscale Funnel 或 Cloudflare Tunnel。
# Caddy 不再签证书、不占 80/443，只在本机 127.0.0.1:8080 收纯 HTTP，隧道指过来就行。
# 换了地址数据不丢：配对凭证跟 .env 里的 SECRET 走、不跟域名走，Host 永远只有一个主人账号；只是 App 得用新地址重新配一次对。
# 端口被占了可以换：MELE_TUNNEL_PORT=9080 mele-host tunnel on
tunnel() {
  local port=${MELE_TUNNEL_PORT:-8080} domain
  case "${1:-status}" in
    on)
      domain=$(bare_domain "${2:-}")
      [ -n "$domain" ] || domain=$(ts_name)
      if [ -z "$domain" ]; then
        echo "用法：mele-host tunnel on 隧道给你的域名"
        echo "  Tailscale 的在管理后台 Machines 里看，长这样：my-pc.tail1234.ts.net"
        exit 1
      fi
      setenv MELE_DOMAIN "$domain"
      setenv MELE_SITE ":80"
      setenv MELE_HTTP_PORT "127.0.0.1:$port"
      setenv MELE_HTTPS_PORT "127.0.0.1:$((port + 363))"
      echo "▸ 切到隧道模式，重启 Host"
      docker compose up -d
      local ok=""
      for _ in $(seq 1 30); do curl -fsS -m 3 "http://127.0.0.1:$port/version" >/dev/null 2>&1 && { ok=1; break; }; sleep 2; done
      [ -n "$ok" ] || { echo "本机 http://127.0.0.1:$port 没起来，看日志：mele-host logs caddy"; exit 1; }
      echo "✅ 本机这头好了：http://127.0.0.1:$port"
      if curl -fsS -m 10 "https://$domain/version" >/dev/null 2>&1; then
        echo "✅ 隧道也通了：https://$domain"
      else
        cat <<TIP

接下来把隧道指到本机 $port 端口（选你用的那个）：
  Tailscale：  sudo tailscale funnel --bg $port
               第一次会给一个链接，点开在网页上同意开 Funnel
  Cloudflare： 隧道的服务地址填 http://localhost:$port
弄好以后浏览器打开 https://$domain/version 能看到一行字，就是通了。
TIP
      fi
      cat <<NEXT

App 里用新地址重新配一次对（以前的聊天、记忆都还在，配上还是原来那些）：
  mele-host pair
NEXT
      ;;
    off)
      domain=$(bare_domain "${2:-}")
      [ -n "$domain" ] || domain=$MELE_DOMAIN
      case "$domain" in *.ts.net)
        echo "关掉隧道以后 Host 要自己签 HTTPS，得有公网 IP 或者域名：mele-host tunnel off 你的域名"; exit 1 ;;
      esac
      sed -i.tmp '/^MELE_SITE=/d;/^MELE_HTTP_PORT=/d;/^MELE_HTTPS_PORT=/d' .env && rm -f .env.tmp
      unset MELE_SITE MELE_HTTP_PORT MELE_HTTPS_PORT
      setenv MELE_DOMAIN "$domain"
      docker compose up -d
      echo "回到 Host 自己签 HTTPS 了：https://$domain（80 / 443 端口要能从外面连进来）"
      echo "地址变了的话，App 里重新配对：mele-host pair"
      ;;
    status)
      if [ "${MELE_SITE:-}" = ":80" ]; then
        echo "隧道模式：对外 https://$MELE_DOMAIN → 本机 http://${MELE_HTTP_PORT:-127.0.0.1:8080}"
      else
        echo "没开隧道模式，Host 自己签 HTTPS：https://$MELE_DOMAIN（开：mele-host tunnel on 你的隧道域名）"
      fi
      ;;
    *) echo "用法：mele-host tunnel on [域名] | off [域名] | status" ;;
  esac
}

bare_domain() {   # 粘过来的 https://xxx/ 也认
  local d=${1#https://}; d=${d#http://}; printf '%s' "${d%%/*}"
}

ts_name() {   # 这台电脑在 Tailscale 里的名字（没装 / 没登录就空）
  command -v tailscale >/dev/null 2>&1 || return 0
  tailscale status --json 2>/dev/null \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null || true
}

# 整台备份（10-17 内测：连 Host 的人手机上的一键备份不带聊天）。一个 .tar.gz 里：
#   mele.dump（数据库：聊天、记忆、设定、TA 们……）、mele_memory.dump（装过独立记忆库才有）、
#   data.tar.gz（照片、头像、贴纸这些文件；记忆模型 hf/ 不带，2GB 多，新机器装的时候自己会下）、
#   env（.env 原样：主密钥解得开存着的模型 key，SECRET 让手机的配对凭证还认）——所以这个文件别给别人。
# 放在同一台服务器上不算备份：服务器没了它也没了。下载到自己电脑上。
backup() {
  local dir=${MELE_BACKUP_DIR:-$PWD/backups} tmp out
  docker compose exec -T db pg_isready -U mele -d mele >/dev/null 2>&1 || { echo "数据库没在跑：先 mele-host start"; exit 1; }
  docker compose exec -T mele true >/dev/null 2>&1 || { echo "Host 没在跑：先 mele-host start"; exit 1; }
  mkdir -p "$dir"
  tmp=$(mktemp -d)
  out="$dir/mele-backup-$(date +%Y%m%d-%H%M).tar.gz"
  echo "▸ 导出数据库"
  docker compose exec -T db pg_dump -U mele -Fc mele > "$tmp/mele.dump"
  if docker compose exec -T db psql -U mele -d mele -tAc "SELECT 1 FROM pg_database WHERE datname = 'mele_memory'" | grep -q 1; then
    docker compose exec -T db pg_dump -U mele -Fc mele_memory > "$tmp/mele_memory.dump"
  fi
  echo "▸ 打包照片和文件（记忆模型不带）"
  docker compose exec -T mele tar czf - -C /data --exclude=./hf . > "$tmp/data.tar.gz"
  cp .env "$tmp/env"
  docker compose exec -T mele printenv NEWAPP_BUILD > "$tmp/build" 2>/dev/null || true
  (umask 077; tar czf "$out" -C "$tmp" .)
  rm -rf "$tmp"
  local size ip
  size=$(du -h "$out" | cut -f1)
  ip=$(curl -fsS4 -m 5 https://api.ipify.org 2>/dev/null || echo 这台服务器的IP)
  cat <<DONE
✅ 备份好了（$size）：$out

⚠️  里面有主密钥，别发给别人。放在这台服务器上不算备份——在你自己电脑的终端里跑这句下载下来：
    scp root@$ip:$out .

恢复（这台，或者新装好的一台）：mele-host restore 备份文件
DONE
}

# 用备份整个换掉这台 Host 的数据。地址、端口、数据库密码用这台自己的；主密钥和 SECRET 用备份里的
# （不然存着的模型 key 解不开、手机的凭证不认）。搬到新服务器：先在新机器上 install.sh，再 restore。
restore() {
  local file=${1:-} tmp ans
  [ -n "$file" ] && [ -f "$file" ] || { echo "用法：mele-host restore mele-backup-xxxx.tar.gz"; exit 1; }
  tmp=$(mktemp -d)
  tar xzf "$file" -C "$tmp" || { rm -rf "$tmp"; echo "解不开这个文件，可能没传完"; exit 1; }
  if [ ! -f "$tmp/mele.dump" ] || [ ! -f "$tmp/data.tar.gz" ] || [ ! -f "$tmp/env" ]; then
    rm -rf "$tmp"; echo "这不是 mele-host backup 打出来的备份"; exit 1
  fi
  if [ "${2:-}" != "--yes" ]; then
    echo "恢复会用备份里的东西整个换掉这台 Host 现在的聊天、记忆、照片，现在的找不回来。"
    read -r -p "确定就打 yes：" ans </dev/tty || ans=""
    [ "$ans" = yes ] || { rm -rf "$tmp"; echo "没动。"; exit 1; }
  fi
  echo "▸ 停下 Host"
  docker compose stop mele >/dev/null
  [ "${COMPOSE_PROFILES:-}" != "memory" ] || docker compose stop memory >/dev/null
  docker compose up -d db >/dev/null 2>&1
  for _ in $(seq 1 30); do docker compose exec -T db pg_isready -U mele -d postgres >/dev/null 2>&1 && break; sleep 2; done
  echo "▸ 换数据库"
  local db
  for db in mele mele_memory; do
    [ -f "$tmp/$db.dump" ] || continue
    docker compose exec -T db psql -U mele -d postgres -qc "DROP DATABASE IF EXISTS $db WITH (FORCE)" -c "CREATE DATABASE $db"
    docker compose exec -T db pg_restore -U mele -d "$db" --no-owner --exit-on-error < "$tmp/$db.dump" \
      || { rm -rf "$tmp"; echo "数据库没恢复成功，上面是报错。这台的数据已经清掉了，修好以后再跑一次 restore。"; exit 1; }
  done
  echo "▸ 换照片和文件"
  docker compose run --rm --no-deps -T --entrypoint sh mele \
    -c 'cd /data && find . -mindepth 1 -maxdepth 1 ! -name hf -exec rm -rf {} + && tar xzf -' < "$tmp/data.tar.gz"
  local k v
  for k in MASTER_KEY SECRET; do
    v=$(sed -n "s/^$k=//p" "$tmp/env" | head -1)
    [ -z "$v" ] || setenv "$k" "$v"
  done
  rm -rf "$tmp"
  echo "▸ 重新启动"
  docker compose up -d >/dev/null 2>&1
  local ok=""
  for _ in $(seq 1 60); do
    docker compose exec -T mele python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)" >/dev/null 2>&1 && { ok=1; break; }
    sleep 3
  done
  [ -n "$ok" ] || { echo "Host 没起来，看日志：mele-host logs"; exit 1; }
  echo "✅ 恢复好了：https://$MELE_DOMAIN"
  echo "手机连的地址跟以前不一样的话，App 里重新配对：mele-host pair"
}

memory() {
  case "${1:-status}" in
    on)
      # 10-17：Host 自己就能把 TA 的记忆开给别的 AI 连（App 里 TA 设定 → 记性 →「让别的 AI 连上 TA 的记忆」），
      # 不用再另装一份独立记忆库（多占 2GB 内存、记忆还分成两本）。真要独立那份：--standalone
      if [ "${2:-}" != "--standalone" ] && [ "${3:-}" != "--standalone" ]; then
        echo "不用装了：Host 本来就有记忆。想让别的 AI（比如 Claude）也连上 TA 的记忆，"
        echo "在 App 里打开 TA 设定 → 记性 →「让别的 AI 连上 TA 的记忆」，生成地址贴过去就行。"
        echo "（真要另装一份独立记忆库：mele-host memory on --standalone）"
        return 0
      fi
      local mem_mb force=${2:-}
      [ "$force" = "--standalone" ] && force=${3:-}
      mem_mb=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
      if [ "$mem_mb" -gt 0 ] && [ "$mem_mb" -lt 5500 ] && [ "$force" != "--force" ]; then
        echo "内存只有 ${mem_mb}MB。记忆库要再多占 2～3GB，建议 6GB 以上，不然两个一起跑会被系统杀掉。"
        echo "硬要装：mele-host memory on --force"
        exit 1
      fi
      [ -n "${MELE_MEMORY_TOKEN:-}" ] || setenv MELE_MEMORY_TOKEN "$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
      if [ -z "${MELE_MEMORY_TZ:-}" ]; then
        setenv MELE_MEMORY_TZ "$(timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || echo UTC)"
      fi
      setenv COMPOSE_PROFILES memory
      echo "▸ 建记忆库的数据库"
      docker compose exec -T db psql -U mele -d mele -tAc "SELECT 1 FROM pg_database WHERE datname = 'mele_memory'" | grep -q 1 \
        || docker compose exec -T db psql -U mele -d mele -qc "CREATE DATABASE mele_memory" >/dev/null
      echo "▸ 拉记忆库镜像、启动"
      docker compose pull -q --ignore-pull-failures memory
      docker compose up -d memory
      echo "▸ 等它起来（模型跟 Host 共用，一般一两分钟）"
      local ok=""
      for _ in $(seq 1 180); do
        if docker compose exec -T memory python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3)" >/dev/null 2>&1; then ok=1; break; fi
        sleep 5
      done
      [ -n "$ok" ] || { echo "记忆库没起来，看看日志：mele-host logs memory"; exit 1; }
      echo "▸ 接到 Mele"
      docker compose exec -T -e MELE_MEMORY_TOKEN="$MELE_MEMORY_TOKEN" mele python -m api.host memory-link </dev/null
      ;;
    off)
      docker compose exec -T mele python -m api.host memory-unlink </dev/null || true
      docker compose rm -sf memory >/dev/null 2>&1 || true
      setenv COMPOSE_PROFILES ""
      echo "记忆库停了，数据还在（再开：mele-host memory on）"
      ;;
    status)
      if [ "${COMPOSE_PROFILES:-}" != "memory" ]; then echo "记忆库没开（开：mele-host memory on）"; return 0; fi
      if docker compose exec -T memory python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3)" >/dev/null 2>&1
      then echo "记忆库开着，好的"; else echo "记忆库开着但没响应，看日志：mele-host logs memory"; fi
      ;;
    *) echo "用法：mele-host memory off | status" ;;
  esac
}

main "$@"
